# Sentry error monitoring (site Worker). Production: wrangler secret put SENTRY_DSN
# Never commit a real DSN. Leave empty locally to disable.
SENTRY_DSN=
# Optional. Defaults to production when PUBLIC_SITE_URL hosts jobappagent.com.
SENTRY_ENVIRONMENT=
# Optional. Set automatically on deploy from GITHUB_SHA; leave empty locally.
SENTRY_RELEASE=

# PostHog (project 556627 JobAppAgent). Server capture uses the secret key.
# Never commit real keys.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Public project API key for landing client pageviews / CTA (Cloudflare var in prod).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional browser host override (defaults to POSTHOG_HOST / us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=

# Dodo Payments server-side configuration. Never expose these keys to browser code.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Generate a unique 32-byte value (for example: openssl rand -hex 32).
# Store it as a secret in production and never reuse it across applications.
RATE_LIMIT_SALT=

# Source for privacy-safe aggregate community statistics.
COMMUNITY_STATS_UPSTREAM=https://job-application-agent-telemetry.varora1406.workers.dev/api/public-stats
COMMUNITY_JOBS_UPSTREAM=https://job-application-agent-telemetry.varora1406.workers.dev/v1/jobs

# Shared only with the scheduled GitHub Actions refund job.
REFUND_CRON_SECRET=

# Public origin used for checkout return and cancellation URLs.
PUBLIC_SITE_URL=http://localhost:3000

# P1 Attention / Resume — see site/docs/ATTENTION.md
# Shared with the hosted runner / CLI notify hook (Bearer).
ATTENTION_NOTIFY_SECRET=
# HMAC secret for /attention/:id?token=… magic links (openssl rand -hex 32).
ATTENTION_MAGIC_LINK_SECRET=
# Resend API key for attention email. Notify fails closed when unset.
RESEND_API_KEY=
# Optional From override. Default: JobAppAgent <attention@jobappagent.com>
RESEND_FROM_EMAIL=
# Ticket 2: agent-box noVNC (historically port 6080). Public HTTPS front optional.
# When set, /api/attention/:id/live-session 302s here after magic-link verify.
ATTENTION_LIVE_SESSION_BASE_URL=
# Optional VNC password injected only on Worker→noVNC redirect (URL fragment). Never emailed.
ATTENTION_NOVNC_PASSWORD=
# Optional founder/dev IAP tunnel one-liner (docs/ops only — never buyer UI).
ATTENTION_IAP_HELPER_COMMAND=
# Optional webhook for on-demand agent-box wake (Personal/ops → gcloud start).
# POST JSON { type, attentionId, reason, source, requestedAt } with Bearer ATTENTION_NOTIFY_SECRET.
ATTENTION_WAKE_URL=
# Optional override for wake instructions on internal/ops wake API when ATTENTION_WAKE_URL is unset.
# Never rendered on the buyer attention live panel.
ATTENTION_WAKE_INSTRUCTIONS=
