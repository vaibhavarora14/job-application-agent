{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "job-application-agent-telemetry",
  "account_id": "69814bd80d183fa809d383323587163f",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/v1/*", "/healthz"]
  },
  // Workers Logs: only the relay's own structured line per request (status, skillVersion, path,
  // durationMs, gate). Invocation logs stay off because they carry request URL/headers/cf/IP.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  },
  "vars": {
    "POSTHOG_HOST": "https://us.i.posthog.com",
    // Clients below this skillVersion get 426 + "Please upgrade: npx job-application-agent@latest".
    "MIN_CLIENT_VERSION": "2.0.0"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "PUBLIC_STATS_DB",
      "database_name": "job-application-agent-public-stats",
      "database_id": "a763216d-064e-4b31-a518-5a978065b879",
      "migrations_dir": "migrations"
    },
    {
      "binding": "PRIVATE_CONTACTS_DB",
      "database_name": "job-application-agent-private-contacts",
      "database_id": "2d0294e0-5218-4c16-a502-a03952a2cc4d",
      "migrations_dir": "migrations-private"
    }
  ],
  "ratelimits": [
    {
      "name": "INSTALL_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "41009",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SOURCE_RATE_LIMITER",
      "namespace_id": "41005",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SOURCE_READ_RATE_LIMITER",
      "namespace_id": "41007",
      "simple": { "limit": 1500, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "name": "job-application-agent-telemetry-staging",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/", "/api/*", "/v1/*", "/healthz"]
      },
      "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
      "vars": { "POSTHOG_HOST": "https://us.i.posthog.com", "MIN_CLIENT_VERSION": "2.0.0" },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "PUBLIC_STATS_DB",
          "database_name": "job-application-agent-public-stats-staging",
          "database_id": "cfad338c-0e53-4b44-a372-886815b8d10e",
          "migrations_dir": "migrations"
        },
        {
          "binding": "PRIVATE_CONTACTS_DB",
          "database_name": "job-application-agent-private-contacts-staging",
          "database_id": "014ea45d-bffe-4930-933a-059cafc1061d",
          "migrations_dir": "migrations-private"
        }
      ],
      "ratelimits": [
        {
          "name": "INSTALL_RATE_LIMITER",
          "namespace_id": "41003",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "EVENT_RATE_LIMITER",
          "namespace_id": "41004",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "41010",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "SOURCE_RATE_LIMITER",
          "namespace_id": "41006",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "SOURCE_READ_RATE_LIMITER",
          "namespace_id": "41008",
          "simple": { "limit": 300, "period": 60 }
        }
      ]
    }
  }
}
